{
  "name": "studypilot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "StudyPilot - AI-Assisted Student Learning Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "test": "npm --prefix backend test",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
