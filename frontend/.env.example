# StudyPilot Frontend Environment Variables

# In local development:
# Either point to http://localhost:3000 (Vite proxy forwards /api to backend) or leave blank for relative /api
VITE_API_URL=http://localhost:3000

# In production on Render (Static Site or Web Service):
# Point to your deployed backend Web Service URL (do NOT include trailing slash)
# Example: VITE_API_URL=https://studypilot-backend.onrender.com
